# Arquivo: .env.example
# Copie este arquivo para .env e preencha com seus próprios valores.
# NUNCA envie o arquivo .env para o repositório.

# === Configs do PostgreSQL (Usado pela API, Worker e Kong) ===
POSTGRES_DB=sinapi
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-in-production-db-pass # TROCAR POR UMA SENHA FORTE

# === Configs do Kong (API Gateway) ===
# O Kong precisa de seu próprio usuário e banco de dados no PostgreSQL.
# NOTA: Os nomes foram padronizados para KONG_PG_* para consistência com o docker-compose.
KONG_PG_USER=kong
KONG_PG_PASSWORD=change-in-production-kong-pass # TROCAR POR UMA SENHA FORTE

# --- Hostnames Internos do Docker (não alterar se estiver usando docker-compose) ---
# Nome do serviço do PostgreSQL no docker-compose, usado pelos outros serviços para se conectar.
KONG_PG_HOST=db

# === Configs da API (FastAPI) ===
# URL de conexão que a API e o Worker usarão para se conectar ao banco de dados.
# Use as mesmas credenciais do POSTGRES_USER e o hostname 'db' do serviço do banco.
# Em produção, SAAS_DATABASE_URL é obrigatória e deve apontar para o banco saas
# do gateway; nunca reutilize silenciosamente o banco de dados SINAPI.
MP_ENVIRONMENT=development
# SAAS_DATABASE_URL=postgresql://admin:change-me@api-gateway-db:5432/saas
# === MessageDispatcher ===
# Credencial dedicada para /api/v1/inbound; não reutilize MD_API_KEY.
# MD_INBOUND_API_KEY=your_inbound_value_here
# MD_API_KEY=your_management_value_here

# === Configs do Cloudflare Tunnel (Opcional) ===
# Token para expor sua API para a internet via túnel.
CLOUDFLARE_TUNNEL_TOKEN=seu-token-aqui